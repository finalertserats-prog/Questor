# ==========================================================================
# QUESTOR ENVIRONMENT CONFIGURATION
# Copy to server/.env . Everything works with ZERO paid keys using the
# built-in open-source heuristic engine + browser Web Speech. Add provider
# keys below to plug in paid components once licensed.
# ==========================================================================

# ---- Core ----
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
# 32+ char secret used to sign session/JWT tokens (change in production)
AUTH_SECRET=dev-questor-secret-change-me-please-32chars
# Signing secret for outbound webhook HMAC signatures
WEBHOOK_SIGNING_SECRET=dev-webhook-secret-change-me

# ---- Database ----
# Default: SQLite (open source, zero-config). For Postgres connector, set:
#   DATABASE_URL="postgresql://user:pass@localhost:5432/questor?schema=public"
# and set PRISMA_PROVIDER=postgresql (see server/prisma/schema.prisma).
DATABASE_URL="file:./data/questor.db"

# ==========================================================================
# LLM PROVIDER (interviewer reasoning, evaluation, report writing)
# provider = heuristic | anthropic | openai
#   heuristic -> built-in, no key required (default, fully offline-capable)
# ==========================================================================
LLM_PROVIDER=heuristic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ==========================================================================
# SPEECH-TO-TEXT  provider = webspeech | whisper | deepgram | azure
#   webspeech -> browser-native, no key required (default)
#
#   COSTS MONEY: `whisper` transcribes on the server and is BILLED PER MINUTE
#   OF AUDIO — not per request. Set STT_PROVIDER=whisper only if you accept
#   that. Leaving this at `webspeech` keeps the build free and key-less.
#
#   Why you might still want it: browser SpeechRecognition in Chrome/Edge
#   streams the candidate's microphone to a GOOGLE speech backend. On networks
#   that block it the candidate sees "Speech error: network" and cannot speak at
#   all. It is also a third-party transfer of candidate audio that your DPA
#   probably does not cover. STT_PROVIDER=whisper keeps audio between the
#   candidate and your own vendor.
#
#   STT_PROVIDER=whisper reuses OPENAI_API_KEY (see LLM section above) and needs
#   no extra credential. Roughly $0.05-0.10 per 45-minute interview at
#   $0.006 / minute: only the candidate's own speech is uploaded (roughly half
#   the session, minus the interviewer's questions and thinking pauses), so a
#   45-minute interview bills 10-15 minutes of audio.
#   If OPENAI_API_KEY is absent the portal answers 204 and browser speech takes
#   over, so a misconfiguration degrades rather than breaks.
# ==========================================================================
STT_PROVIDER=webspeech
# Optional override for STT_PROVIDER=whisper. Default is gpt-4o-transcribe:
# lower word error rate than whisper-1 at the same per-minute price, which
# matters because a mis-transcribed answer becomes silently wrong hiring
# evidence. gpt-4o-mini-transcribe is ~half the price if you prefer that trade.
OPENAI_STT_MODEL=gpt-4o-transcribe
DEEPGRAM_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# ==========================================================================
# TEXT-TO-SPEECH  provider = webspeech | openai | elevenlabs | azure
#   webspeech -> browser-native, no key required (default)
#
#   COSTS MONEY: `openai` and `elevenlabs` synthesize on the server and are
#   billed per interview. Set TTS_PROVIDER=openai only if you accept that.
#   Leaving this at `webspeech` keeps the whole build free and key-less; the
#   interviewer then uses OS voices, which sound noticeably robotic.
#
#   TTS_PROVIDER=openai reuses OPENAI_API_KEY (see LLM section above) and needs
#   no extra credential. Roughly $0.05-0.15 of audio per 45-minute interview at
#   $12 / 1M output audio tokens, since only the interviewer's own questions are
#   spoken and repeats are served from cache.
#   If OPENAI_API_KEY is absent the portal answers 204 and the browser voice
#   takes over, so a misconfiguration degrades rather than breaks.
# ==========================================================================
TTS_PROVIDER=webspeech
# Optional overrides for TTS_PROVIDER=openai. Defaults are gpt-4o-mini-tts +
# marin: the highest-quality voice OpenAI documents, and the only model tier
# that accepts tone instructions. `marin` and `cedar` require gpt-4o-mini-tts —
# they do not exist on tts-1 / tts-1-hd.
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin

# ---- TTS_PROVIDER=elevenlabs ----
#   The most natural-sounding option, and the MOST EXPENSIVE BY A WIDE MARGIN.
#   Read the cost note below before switching: this is roughly 10-20x the
#   OpenAI TTS bill for the same interview, not a few percent.
#
#   ElevenLabs bills 1 CREDIT PER CHARACTER of text on eleven_multilingual_v2
#   (the default below); the flash/turbo tiers bill half that. Only the
#   interviewer's own questions are spoken and repeats are served from cache,
#   which works out around 6,000-10,000 characters for a 45-minute interview.
#
#   Cost per 45-minute interview, honestly:
#     OpenAI TTS      ~$0.05 - $0.15   (see the section above)
#     ElevenLabs      ~$1.00 - $2.00   at typical Creator/Pro per-credit rates
#     ElevenLabs      ~$0.50 - $1.00   with ELEVENLABS_MODEL_ID=eleven_flash_v2_5
#
#   Those dollar figures assume roughly $0.12-$0.22 per 1,000 credits, which is
#   the range ElevenLabs' subscription tiers work out to — CONFIRM AGAINST YOUR
#   OWN PLAN at elevenlabs.io/pricing before budgeting, since the per-credit
#   rate drops substantially on the larger tiers and these are not contractual.
#   The per-character billing model itself is from the ElevenLabs API docs.
#
#   Worth it when the voice is the product — high-volume candidate-facing
#   screening where a robotic interviewer costs you completions. Hard to justify
#   for internal or low-volume use, where OpenAI TTS is already well clear of
#   browser speech at a fraction of the price.
#
#   If ELEVENLABS_API_KEY is absent the portal answers 204 and the browser voice
#   takes over, so a misconfiguration degrades rather than breaks — the same
#   contract as every other speech provider here.
ELEVENLABS_API_KEY=
# Voice id. Default is JBFqnCBsd6RMkjVDRZzb ("George"): a premade voice present
# on every account, warm and measured rather than announcer-bright, which suits
# an interviewer talking to an already-nervous candidate. Audition it and pick
# your own — voice is a product decision. Browse at elevenlabs.io/voice-library.
ELEVENLABS_VOICE_ID=
# Model id. Default is eleven_multilingual_v2: the current documented default
# for the text-to-speech endpoint and the high-fidelity tier. Set
# eleven_flash_v2_5 to halve the credit cost and cut latency, at some fidelity.
# NOTE: eleven_turbo_v2 is deprecated by the vendor — do not set it.
ELEVENLABS_MODEL_ID=

# ==========================================================================
# EMAIL / COMMS  provider = console | smtp | sendgrid
#   console -> logs invitations to server console (default)
# ==========================================================================
EMAIL_PROVIDER=console
EMAIL_FROM="Questor Interviews <no-reply@questor.local>"
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ==========================================================================
# ATS  provider = generic | greenhouse | csv
# ==========================================================================
ATS_PROVIDER=generic
ATS_BASE_URL=
ATS_API_KEY=

# ==========================================================================
# MEETING ADAPTERS  provider = hosted | teams | zoom | meet
#   hosted -> Questor-hosted browser room (default, MVP)
# ==========================================================================
MEETING_PROVIDER=hosted
