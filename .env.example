# ==========================================================================
# QUESTOR ENVIRONMENT CONFIGURATION
# Copy to server/.env . Everything works with ZERO paid keys using the
# built-in open-source heuristic engine + browser Web Speech. Add provider
# keys below to plug in paid components once licensed.
# ==========================================================================

# ---- Core ----
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
# 32+ char secret used to sign session/JWT tokens (change in production)
AUTH_SECRET=dev-questor-secret-change-me-please-32chars
# Signing secret for outbound webhook HMAC signatures
WEBHOOK_SIGNING_SECRET=dev-webhook-secret-change-me

# --- Encryption of candidate content at rest -------------------------------
# Seals the CV text, interview transcript and report stored in
# Artifact.storageKey, so a database backup no longer carries them in clear.
# The order matters and is written out in docs/RUNBOOK.md,
# "Encryption of candidate content at rest":
#   1. set ARTIFACT_ENCRYPTION_KEY (leave the switch off) and restart
#   2. npm run artifacts:encrypt -w server        (safe to re-run; resumable)
#   3. set ARTIFACT_ENCRYPTION_ENABLED=true and restart
# Reading is transparent throughout, so nothing has to be taken down.
# A 32-byte key: openssl rand -base64 32   (hex is accepted too)
# ARTIFACT_ENCRYPTION_KEY=
# Keys being retired during a rotation. They open old rows and seal nothing.
# Comma-separated.
# ARTIFACT_ENCRYPTION_KEYS_PREVIOUS=
# Off by default. On WITHOUT a key is refused at boot in production.
# ARTIFACT_ENCRYPTION_ENABLED=false
# On SIGINT/SIGTERM, wait up to this many ms for interviews in progress to end
# before exiting (default 1200000 = 20 min). deploy.sh sets pm2's kill timeout
# to this plus 60 s.
# SHUTDOWN_DRAIN_MS=1200000
# Where rate-limit counters live: database (shared by all instances; the
# default when NODE_ENV=production) or memory (per process; the default
# otherwise).
# RATE_LIMIT_STORE=database
# The legacy v1 webhook signature header. Unset/on: each webhook's own setting
# decides. off: never sent. Set off once every receiver verifies v2.
# WEBHOOK_V1_SIGNATURE=off
# Where the nightly database dumps are written. Admin -> System health reports
# the newest questor-*.dump in here and how old it is (warn past 26 h, fail
# past 50 h), so a backup that stopped running is visible without SSH. Leave
# unset in development; in production it defaults to /root/Questor/backups.
# The app only needs to read the folder. See docs/RUNBOOK.md.
# BACKUP_DIR=/root/Questor/backups

# ---- Platform owner ----
# Comma-separated emails (any case) of the platform owner(s): they alone review
# the shared role catalog at /catalog-review. Empty means nobody can (fails closed).
PLATFORM_OPERATOR_EMAILS=
# Approves account requests; also gets the catalog refresh summary when
# PLATFORM_OPERATOR_EMAILS is empty.
SIGNUP_APPROVER_EMAIL=

# ---- Database ----
# Default: SQLite (open source, zero-config). For Postgres connector, set:
#   DATABASE_URL="postgresql://user:pass@localhost:5432/questor?schema=public"
# and set PRISMA_PROVIDER=postgresql (see server/prisma/schema.prisma).
DATABASE_URL="file:./data/questor.db"

# ==========================================================================
# LLM PROVIDER (interviewer reasoning, evaluation, report writing)
# provider = heuristic | anthropic | openai
#   heuristic -> built-in, no key required (default, fully offline-capable)
# ==========================================================================
LLM_PROVIDER=heuristic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
# Any Chat Completions model. Reasoning models (gpt-5 family, o1/o3/o4) are
# detected by name and sent max_completion_tokens + reasoning_effort instead of
# max_tokens + temperature. Production runs e.g.:
#   OPENAI_MODEL=gpt-5.6-sol
OPENAI_MODEL=gpt-4o
# How long a reasoning model thinks before an interviewer turn:
# none | minimal | low | medium | high. Default low — a spoken turn has to feel
# immediate. Grading asks for medium on its own. Ignored by non-reasoning models.
OPENAI_REASONING_EFFORT=low
# Longest a candidate waits on the model for the interviewer's next turn before
# the built-in question is used instead (milliseconds, at least 1000).
INTERVIEWER_LLM_TIMEOUT_MS=12000

# ---- Local model fallback (Ollama on the same server; off by default) ----
# When the AI provider fails (no credit, bad key, outage, too slow) the
# interviewer's spoken turns move to a small local model, then to the built-in
# writer. The local model only writes the acknowledgement around a question the
# plan already holds; grading and reports never use it. Off = exactly the old
# chain (provider, then built-in writer). See docs/RUNBOOK.md "Local model fallback".
LOCAL_LLM_ENABLED=false
# Ollama's address; keep it on loopback.
# LOCAL_LLM_URL=http://127.0.0.1:11434
# Chosen by the benchmark (npm run llm:bench -w server). llama3.2:3b or phi4-mini.
# LOCAL_LLM_MODEL=llama3.2:3b
# Past these, the built-in writer takes the turn rather than leave the candidate waiting.
# LOCAL_LLM_FIRST_TOKEN_MS=8000
# LOCAL_LLM_TIMEOUT_MS=12000
# How long Ollama keeps the model in memory between calls.
# LOCAL_LLM_KEEP_ALIVE=24h
# How long a failing provider is skipped before one probe (doubles on each
# repeated failure, up to LLM_MAX_COOLDOWN_MS). Out of credit / bad key:
# LLM_OUTAGE_COOLDOWN_MS=300000
# Timeouts, 5xx, rate limits, dropped connections, repeated slow answers:
# LLM_TRANSIENT_COOLDOWN_MS=30000
# LLM_MAX_COOLDOWN_MS=900000
# A provider answering slower than this twice running is treated as failing.
# LLM_SLOW_CALL_MS=8000

# ---- HR-Box emails (docs/RUNBOOK.md, "HR-Box reminders and daily summary") ----
# Candidate reminders at day 3 and day 10 of the invitation, and the owning
# recruiter's warning ~2 days before it closes. Off until the owner turns it on.
REMINDERS_ENABLED=false
# Invitations sent before reminders were switched on are never chased. The job
# stamps that moment itself on its first run with the switch on (the
# ReminderWindow row) and never moves it, so nothing has to be set here to turn
# reminders on safely. Set this only to move the line afterwards: an ISO date
# ("2026-09-24", read as midnight UTC) or date-time ("2026-09-24T09:00:00Z").
# Earlier picks up invitations already in flight; later holds reminders off
# until then. Clearing it goes back to the stamp.
REMINDERS_START_AT=
# Each HR user's "Needs you" rows by email once a day; each user can opt out in Settings.
DIGEST_ENABLED=false
# The hour (0-23) on the organisation's own clock from which the summary may go.
DIGEST_HOUR=8

# ---- Shared catalog refresh (monthly; nothing is added until the owner approves) ----
# O*NET 31.0 CSV tables (CC BY 4.0) and the ESCO public API. No keys needed.
CATALOG_ONET_BASE_URL=https://www.onetcenter.org/dl_files/database/db_31_0_csv
CATALOG_ESCO_BASE_URL=https://ec.europa.eu/esco/api
# Per-run caps.
CATALOG_REFRESH_MAX_LLM_CALLS=150
CATALOG_REFRESH_MAX_PROPOSALS=200
# A new role below this classification confidence (0 to 1) is skipped, not queued.
CATALOG_REFRESH_MIN_CONFIDENCE=0.5
# At most this share (0 to 1) of a run's proposals may be alternative titles,
# so new roles always get room.
CATALOG_REFRESH_MAX_ALIAS_SHARE=0.6
# Rolling budgets over any 30 days, all runs together (manual runs included).
CATALOG_REFRESH_LLM_CALLS_PER_30_DAYS=150
CATALOG_RESEARCH_CALLS_PER_30_DAYS=35
# Minimum gap between two manual runs (ms).
CATALOG_MANUAL_RUN_GAP_MS=3600000
# Timeout for each classification model call (ms, at least 1000).
CATALOG_CLASSIFY_TIMEOUT_MS=60000
# ESCO: occupations per page, pages per run, existing titles looked up per run,
# and the pause between requests (ms).
CATALOG_ESCO_LIMIT=25
CATALOG_ESCO_PAGES_PER_RUN=8
CATALOG_ESCO_ROLE_LOOKUPS_PER_RUN=40
CATALOG_ESCO_DELAY_MS=500
# Timeout for each O*NET/ESCO request (ms, at least 1000).
CATALOG_FETCH_TIMEOUT_MS=60000
# Web research for emerging titles uses OPENAI_API_KEY; skipped without it.
CATALOG_RESEARCH_MODEL=gpt-5.5
CATALOG_RESEARCH_MAX_CALLS=35
CATALOG_RESEARCH_TIMEOUT_MS=120000

# ==========================================================================
# SPEECH-TO-TEXT  provider = webspeech | whisper | deepgram | azure
#   webspeech -> browser-native, no key required (default)
#
#   COSTS MONEY: `whisper` transcribes on the server and is BILLED PER MINUTE
#   OF AUDIO — not per request. Set STT_PROVIDER=whisper only if you accept
#   that. Leaving this at `webspeech` keeps the build free and key-less.
#
#   Why you might still want it: browser SpeechRecognition in Chrome/Edge
#   streams the candidate's microphone to a GOOGLE speech backend. On networks
#   that block it the candidate sees "Speech error: network" and cannot speak at
#   all. It is also a third-party transfer of candidate audio that your DPA
#   probably does not cover. STT_PROVIDER=whisper keeps audio between the
#   candidate and your own vendor.
#
#   STT_PROVIDER=whisper reuses OPENAI_API_KEY (see LLM section above) and needs
#   no extra credential. Roughly $0.05-0.10 per 45-minute interview at
#   $0.006 / minute: only the candidate's own speech is uploaded (roughly half
#   the session, minus the interviewer's questions and thinking pauses), so a
#   45-minute interview bills 10-15 minutes of audio.
#   If OPENAI_API_KEY is absent the portal answers 204 and browser speech takes
#   over, so a misconfiguration degrades rather than breaks.
# ==========================================================================
STT_PROVIDER=webspeech
# Optional override for STT_PROVIDER=whisper. Default is gpt-4o-transcribe:
# lower word error rate than whisper-1 at the same per-minute price, which
# matters because a mis-transcribed answer becomes silently wrong hiring
# evidence. gpt-4o-mini-transcribe is ~half the price if you prefer that trade.
OPENAI_STT_MODEL=gpt-4o-transcribe
DEEPGRAM_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# ==========================================================================
# TEXT-TO-SPEECH  provider = webspeech | openai | elevenlabs | azure
#   webspeech -> browser-native, no key required (default)
#
#   COSTS MONEY: `openai` and `elevenlabs` synthesize on the server and are
#   billed per interview. Set TTS_PROVIDER=openai only if you accept that.
#   Leaving this at `webspeech` keeps the whole build free and key-less; the
#   interviewer then uses OS voices, which sound noticeably robotic.
#
#   TTS_PROVIDER=openai reuses OPENAI_API_KEY (see LLM section above) and needs
#   no extra credential. Roughly $0.05-0.15 of audio per 45-minute interview at
#   $12 / 1M output audio tokens, since only the interviewer's own questions are
#   spoken and repeats are served from cache.
#   If OPENAI_API_KEY is absent the portal answers 204 and the browser voice
#   takes over, so a misconfiguration degrades rather than breaks.
# ==========================================================================
TTS_PROVIDER=webspeech
# Optional overrides for TTS_PROVIDER=openai. Defaults are gpt-4o-mini-tts +
# marin: the highest-quality voice OpenAI documents, and the only model tier
# that accepts tone instructions. `marin` and `cedar` require gpt-4o-mini-tts —
# they do not exist on tts-1 / tts-1-hd.
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin

# ---- TTS_PROVIDER=elevenlabs ----
#   The most natural-sounding option, and the MOST EXPENSIVE BY A WIDE MARGIN.
#   Read the cost note below before switching: this is roughly 10-20x the
#   OpenAI TTS bill for the same interview, not a few percent.
#
#   ElevenLabs bills 1 CREDIT PER CHARACTER of text on eleven_multilingual_v2
#   (the default below); the flash/turbo tiers bill half that. Only the
#   interviewer's own questions are spoken and repeats are served from cache,
#   which works out around 6,000-10,000 characters for a 45-minute interview.
#
#   Cost per 45-minute interview, honestly:
#     OpenAI TTS      ~$0.05 - $0.15   (see the section above)
#     ElevenLabs      ~$1.00 - $2.00   at typical Creator/Pro per-credit rates
#     ElevenLabs      ~$0.50 - $1.00   with ELEVENLABS_MODEL_ID=eleven_flash_v2_5
#
#   Those dollar figures assume roughly $0.12-$0.22 per 1,000 credits, which is
#   the range ElevenLabs' subscription tiers work out to — CONFIRM AGAINST YOUR
#   OWN PLAN at elevenlabs.io/pricing before budgeting, since the per-credit
#   rate drops substantially on the larger tiers and these are not contractual.
#   The per-character billing model itself is from the ElevenLabs API docs.
#
#   Worth it when the voice is the product — high-volume candidate-facing
#   screening where a robotic interviewer costs you completions. Hard to justify
#   for internal or low-volume use, where OpenAI TTS is already well clear of
#   browser speech at a fraction of the price.
#
#   If ELEVENLABS_API_KEY is absent the portal answers 204 and the browser voice
#   takes over, so a misconfiguration degrades rather than breaks — the same
#   contract as every other speech provider here.
ELEVENLABS_API_KEY=
# Voice id. Default is JBFqnCBsd6RMkjVDRZzb ("George"): a premade voice present
# on every account, warm and measured rather than announcer-bright, which suits
# an interviewer talking to an already-nervous candidate. Audition it and pick
# your own — voice is a product decision. Browse at elevenlabs.io/voice-library.
ELEVENLABS_VOICE_ID=
# Model id. Default is eleven_multilingual_v2: the current documented default
# for the text-to-speech endpoint and the high-fidelity tier. Set
# eleven_flash_v2_5 to halve the credit cost and cut latency, at some fidelity.
# NOTE: eleven_turbo_v2 is deprecated by the vendor — do not set it.
ELEVENLABS_MODEL_ID=

# ==========================================================================
# EMAIL / COMMS  provider = console | smtp | sendgrid
#   console -> logs invitations to server console (default)
# ==========================================================================
EMAIL_PROVIDER=console
EMAIL_FROM="Questor Interviews <no-reply@questor.local>"
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ==========================================================================
# ATS  provider = generic | greenhouse | csv
# ==========================================================================
ATS_PROVIDER=generic
ATS_BASE_URL=
ATS_API_KEY=

# ==========================================================================
# MEETING ADAPTERS  provider = hosted | teams | zoom | meet
#   hosted -> Questor-hosted browser room (default, MVP)
# ==========================================================================
MEETING_PROVIDER=hosted

# --------------------------------------------------------------------------
# Meeting links for HUMAN interview rounds  provider = manual | teams | zoom | meet
#   manual -> recruiters paste a link (default; needs nothing below)
#   An organisation can override this in Admin -> Connectors.
#   Credentials are server-only: never logged, never returned by the API.
# --------------------------------------------------------------------------
ROUND_MEETING_PROVIDER=manual

# Zoom: Server-to-Server OAuth app (scopes meeting:write/update/delete:meeting:admin)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# Email or user id of the Zoom user who hosts interview meetings
ZOOM_HOST_USER_ID=

# Microsoft Teams: Entra app registration, Graph application permission
# Calendars.ReadWrite with admin consent
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
# Object id or email of the mailbox whose calendar holds the meetings
MS_GRAPH_ORGANIZER_USER_ID=

# Google Meet: service account with domain-wide delegation for
# https://www.googleapis.com/auth/calendar.events (Calendar API enabled)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# private_key from the JSON key file, in double quotes, keeping its \n sequences
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Workspace user the events are created as
GOOGLE_IMPERSONATED_USER=

# ---------------------------------------------------------------------------
# Question & Answer Library (docs/plans/question-answer-library-plan-v2.md).
# Dark by default: with both switches off the API mounts only GET /api/library/status
# and the worker process (pm2 "questor-library", `npm run library:worker`) exits at once.
# The one kill switch for the API: mounts the read API (select, entries) and the owner's screen. Off: only GET /api/library/status.
LIBRARY_ENABLED=false
# The fill worker (its own process). It never mounts routes; the owner's screen needs LIBRARY_ENABLED too.
LIBRARY_WORKER_ENABLED=false
# Model calls (generator + critic together) the worker may make per UTC day; it pauses at the cap and resumes next day
LIBRARY_DAILY_CALL_CAP=3000
# Tokens (in + out, both models) over any rolling 30 days
LIBRARY_MONTHLY_TOKEN_CAP=100000000
# The critic must be a different model family from the generator (LLM_PROVIDER). anthropic | openai
LIBRARY_CRITIC_PROVIDER=anthropic
LIBRARY_CRITIC_MODEL=claude-sonnet-5
# Batches run side by side; each is one generator call and one critic call
LIBRARY_WORKER_CONCURRENCY=4
# The Anthropic critic needs ANTHROPIC_API_KEY (above). Without it the worker pauses as critic_unavailable; it never falls back to same-family critique.
